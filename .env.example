PORT=5011

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=stokvela
# Leave unset for local dev. Set to "true" when DB_HOST points at a hosted
# Postgres that requires an encrypted connection (Neon, Render Postgres,
# etc.) — without it the connection is rejected outright.
DB_SSL=

FRONTEND_URL=http://localhost:5010

# Generate a real one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-generated-secret
JWT_EXPIRES_IN=30d
